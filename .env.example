# ============================================================
# DevDocs Copilot 环境变量示例
# 复制本文件为 .env，填入你自己的密钥；切勿在本文件中写真实 Key
# ============================================================

# ===== 聊天模型：Agnes =====
# 控制台获取：https://agnes-ai.com
AGNES_API_KEY=your-agnes-api-key
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
CHAT_MODEL=agnes-2.5-flash

# ===== Embedding / Rerank：硅基流动 =====
# 控制台获取：https://siliconflow.cn
SILICONFLOW_API_KEY=your-siliconflow-api-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ===== 服务配置 =====
HOST=0.0.0.0
PORT=8000
# 调试模式：true 开启热重载，生产环境设为 false
DEBUG=true

# ===== Agent =====
# ReAct 最大工具调用轮数，默认 5
# AGENT_MAX_STEPS=5

# ===== 向量数据库 =====
COLLECTION_NAME=devdocs
# CHROMA_DATA_DIR 不设置则默认 <项目根>/data/chroma

# ===== 文档配置 =====
CHUNK_SIZE=500
CHUNK_OVERLAP=50
# UPLOAD_DIR 不设置则默认 <项目根>/uploads

# ===== 检索配置 =====
CANDIDATE_K=20
FUSED_K=10
TOP_K=5
