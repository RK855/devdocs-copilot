# ================================================================
#  【首次使用必读】DevDocs Copilot · API Key 配置文件
# ================================================================
#
#  本程序本身不包含 AI 模型，问答能力由两个云端模型提供，
#  因此需要你各申请一个 API Key 填在下面。
#  好消息：这两个平台的对应模型【目前都可以在官网免费申请】，
#  注册即可领取，免费额度足够日常学习使用。
#
#  ---------- 怎么填？ ----------
#  把下面等号 = 后面的 your-xxx 整段替换成你自己的 Key，例如：
#
#      AGNES_API_KEY=sk-abc123def456xxxx
#
#  注意只改等号后面的内容，等号两边不要加空格，不要加引号。
#  两个 Key 都填好后，按 Ctrl+S 保存，关闭记事本即可。
#
#  ---------- Key 去哪里申请？ ----------
#  ① Agnes —— 聊天模型（负责理解问题、组织回答）
#       官网注册后在控制台创建 Key：https://agnes-ai.com
#       填到下面这一行：                 AGNES_API_KEY=
#
#  ② 硅基流动 SiliconFlow —— 向量 / 精排模型（负责文档检索）
#       官网注册后在控制台创建 Key：https://siliconflow.cn
#       填到下面这一行：                 SILICONFLOW_API_KEY=
#
#  ---------- 想用别的平台或别的模型？ ----------
#  本项目的模型接口全部兼容 OpenAI 协议，可以自行替换（变量名
#  保持不动，只改等号后面的值）：
#
#  · 换聊天模型：改 AGNES_BASE_URL 和 CHAT_MODEL 两行的值，
#                 并把 AGNES_API_KEY 换成新平台的 Key。
#
#  · 换向量模型：改 SILICONFLOW_BASE_URL 和 EMBEDDING_MODEL，
#                 并把 EMBEDDING_DIM 改成新模型的实际输出维度
#                （默认 bge-m3 是 1024）。
#                 【重要】换向量模型后，旧向量库维度不匹配，
#                 必须重建：删除程序文件夹里的 data 目录后重启，
#                 随包预置的文档会自动重新灌入。
#
#  · 新平台不支持精排（rerank）接口：把 RERANK_ENABLED 改为 false。
#
#  除两个 Key 外，其余配置保持默认即可，不懂可以先不用改。
# ================================================================


# ===== ① 聊天模型：Agnes =====
# 免费申请 Key：https://agnes-ai.com
AGNES_API_KEY=your-agnes-api-key
# 换用其他 OpenAI 兼容平台时，修改下面两行的值
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
CHAT_MODEL=agnes-2.5-flash


# ===== ② 向量检索 / 精排：硅基流动 SiliconFlow =====
# 免费申请 Key：https://siliconflow.cn
SILICONFLOW_API_KEY=your-siliconflow-api-key
# 换用其他 OpenAI 兼容平台时，修改下面两行的值
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
# 向量维度必须与上面的模型一致；换模型后需删除 data 目录重建向量库
EMBEDDING_DIM=1024
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 平台不支持精排接口时设为 false，检索仍可正常工作
RERANK_ENABLED=true


# ===== 服务配置（一般无需修改） =====
HOST=0.0.0.0
PORT=8000
# 调试模式：true 开启热重载（仅开发用）；桌面版启动时会自动改为 false
DEBUG=true

# ===== Agent =====
# ReAct 最大工具调用轮数，默认 5
# AGENT_MAX_STEPS=5

# ===== 向量数据库 =====
COLLECTION_NAME=devdocs
# CHROMA_DATA_DIR 不设置则默认使用程序文件夹下的 data/chroma

# ===== 文档切分配置 =====
CHUNK_SIZE=500
CHUNK_OVERLAP=50
# UPLOAD_DIR 不设置则默认使用程序文件夹下的 uploads

# ===== 检索配置（保持默认即可） =====
CANDIDATE_K=20
FUSED_K=10
TOP_K=5
